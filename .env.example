# ==============================================================================
# AccessGate - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values according to your environment.
# DO NOT commit real secrets or credentials to public source repositories.
# ==============================================================================

# Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Express HTTP server listens
PORT=3000

# Environment mode ('development', 'production', or 'test')
# In 'production', HSTS is enforced, logging uses Apache combined format, and errors omit internal stack traces.
NODE_ENV=development

# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Full connection string for the primary PostgreSQL database instance
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DB_URL=postgres://postgres:postgres@localhost:5432/accessgate

# Cache & Session Store Configuration (Redis)
# ------------------------------------------------------------------------------
# Redis connection URL for distributed token blacklisting and rate limiting
# Format: redis://[<username>:<password>@]<host>:<port>
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (JSON Web Tokens)
# ------------------------------------------------------------------------------
# High-entropy secret key used to sign and verify short-lived access tokens (15m expiry)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_super_secret_key_change_in_production_min32chars

# High-entropy secret key used to sign and verify long-lived refresh tokens (7d expiry)
# Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET=your_jwt_refresh_super_secret_key_change_in_production_min32chars

# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Whitelisted allowed origins. Use '*' for open development or comma-separated URLs in production
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting & Brute-Force Defense
# ------------------------------------------------------------------------------
# Window duration in milliseconds for rate limiter calculations (e.g. 900000 ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window allowed for general API routes
RATE_LIMIT_MAX_REQUESTS=100

# Maximum requests per window allowed for authentication routes (/auth/*)
# Protects against credential stuffing and password brute-force attacks
AUTH_RATE_LIMIT_MAX=20

# Maximum requests per window allowed for sensitive admin operations (/admin/*)
ADMIN_RATE_LIMIT_MAX=30

# Google OAuth2 Authentication (Sign in with Google)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID (from Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Cloud Console OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Authorized redirect URI registered in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
